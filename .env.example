# Current pages use a Supabase publishable/anon key in the browser.
# Publishable keys are designed to be public; protect every table with RLS.
# Do not place a service-role/secret key in HTML, JavaScript, or any NEXT_PUBLIC_* variable.

# Supabase Edge Function runtime values (server-side only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional local migration tooling only; keep private and out of Git
DATABASE_URL=
